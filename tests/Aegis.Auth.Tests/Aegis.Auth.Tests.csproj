<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ITfoxtec.Identity.Saml2" Version="4.22.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <!-- OIDC provider spike (#116): pinned per docs/adr/0002-oidc-provider-engine.md. -->
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.9.0" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.9.0" />
    <PackageReference Include="Testcontainers.Keycloak" Version="4.17.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Spikes\SamlLibrary\aegis-saml-poc-realm.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Aegis.Auth\Aegis.Auth.csproj" />
    <ProjectReference Include="..\..\src\Aegis.Auth.Http\Aegis.Auth.Http.csproj" />
    <ProjectReference Include="..\..\src\Aegis.Auth.Organizations\Aegis.Auth.Organizations.csproj" />
    <ProjectReference Include="..\Aegis.Auth.TestPlugins\Aegis.Auth.TestPlugins.csproj" />
